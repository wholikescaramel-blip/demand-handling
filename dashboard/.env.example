# Neon connection string (Project > Connection details). Leave unset to preview with demo data.
DATABASE_URL=

# Shared secret: the same value goes in Apps Script as SYNC_SECRET. Generate a long random string.
SYNC_SECRET=

# Password for the dashboard login page.
DASHBOARD_PASSWORD=

# Optional: Gemini blended price per 1M tokens in INR, to show a running cost. Blank = free tier (shown as Rs 0).
GEMINI_COST_PER_MILLION_TOKENS_INR=

# --- Purchase order PDF (all optional; defaults are fine) ---
COMPANY_NAME=Freshroots
COMPANY_ADDRESS=
COMPANY_GSTIN=
COMPANY_CONTACT=
COMPANY_EMAIL=
# Ship-to lines separated by |
SHIP_TO=Freshroots|Pune Central Warehouse, Pune
PO_EXPIRY_DAYS=7
PAYMENT_TERMS=
# Terms and conditions, clauses separated by | (blank = built-in defaults)
PO_TERMS=
# Generated POs older than this many days stop counting as stock on order (default 21).
OPEN_PO_DAYS=21

# --- Email a PO from the dashboard (optional) ---
# URL of the Apps Script web app (apps-script/Mail.js). Without it, Download still works.
MAIL_WEBHOOK_URL=
