# Neon connection string (Project > Connection details). Leave unset to preview with demo data.
DATABASE_URL=

# Shared secret: the same value goes in Apps Script as SYNC_SECRET. Generate a long random string.
SYNC_SECRET=

# Password for the dashboard login page.
DASHBOARD_PASSWORD=

# Optional: Gemini blended price per 1M tokens in INR, to show a running cost. Blank = free tier (shown as Rs 0).
GEMINI_COST_PER_MILLION_TOKENS_INR=

# --- Zoho Inventory (purchase orders after approval, and open POs read-back) ---
# Create a Self Client at api-console.zoho.in (use your data centre), then generate a refresh token with scopes:
#   ZohoInventory.purchaseorders.CREATE,ZohoInventory.purchaseorders.READ,ZohoInventory.items.READ,ZohoInventory.contacts.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# Data centre suffix: in | com | eu | com.au | jp | ca  (default: in)
ZOHO_DC=in
# draft = procurement issues the PO in Zoho (default). issued = created and issued straight away.
ZOHO_PO_STATUS=draft
# Distributor id (from SKU master) -> Zoho vendor contact_id. If a vendor is not in the map, the dashboard looks the
# distributor up by exact name, then falls back to ZOHO_DEFAULT_VENDOR_ID.
ZOHO_VENDOR_MAP={"DIST001":"","DIST002":"","DIST003":"","DIST004":""}
ZOHO_DEFAULT_VENDOR_ID=
# Only if your Zoho org does not auto-number purchase orders; PO numbers become PREFIX-YYYYMMDD-DISTRIBUTOR.
ZOHO_PO_NUMBER_PREFIX=
