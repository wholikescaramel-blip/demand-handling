# Neon: Connect > Connection pooling ON > copy the connection string.
DATABASE_URL=

# The password the team types on the dashboard login page.
DASHBOARD_PASSWORD=

# Protects the twice-weekly scheduled run (/api/cron/run). Any long random string. Vercel sends it automatically once set.
CRON_SECRET=

# --- Optional ---

# Gemini words the reasons on the Review cards. Without it the standard wording is used.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Send purchase orders by email from the dashboard. Gmail: use an app password (Google account > Security > 2-Step Verification > App passwords).
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=Freshroots Purchasing <you@gmail.com>

# Purchase order document (defaults are fine)
COMPANY_NAME=Freshroots
COMPANY_ADDRESS=
COMPANY_GSTIN=
COMPANY_CONTACT=
COMPANY_EMAIL=
# Ship-to lines separated by |
SHIP_TO=Freshroots|Pune Central Warehouse, Pune
PO_EXPIRY_DAYS=7
PAYMENT_TERMS=
# Terms and conditions, clauses separated by | (blank = built-in defaults)
PO_TERMS=
# POs older than this many days stop counting as stock on order even if nobody marked them received (default 21).
OPEN_PO_DAYS=21
