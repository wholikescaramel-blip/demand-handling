# Neon connection string (Project > Connection details). Leave unset to preview with demo data.
DATABASE_URL=

# Shared secret: the same value goes in Apps Script as SYNC_SECRET. Generate a long random string.
SYNC_SECRET=

# Password for the dashboard login page.
DASHBOARD_PASSWORD=

# Optional: Gemini blended price per 1M tokens in INR, to show a running cost. Blank = free tier (shown as Rs 0).
GEMINI_COST_PER_MILLION_TOKENS_INR=

# --- Purchase order PDF (all optional) ---
COMPANY_NAME=Freshroots
SHIP_TO=Pune Central Warehouse, Pune
# Generated POs older than this many days stop counting as stock on order (default 21).
OPEN_PO_DAYS=21
